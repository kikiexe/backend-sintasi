  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Encrypted Payload - AES-256-CBC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}",
                  "pm.test('Encrypted login status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"AQIDBAUGBwgJCgsMDQ4PEA==:+1/x566yXv+slPfmmkR5EvhVCXkCiwSMokMCu5hSkDM=\",\n  \"password\": \"EA8ODQwLCgkIBwYFBAMCAQ==:aEilm+8UOUIpTTT1q0Ttrg==\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Login (Plain Text)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
